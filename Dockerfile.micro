FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/logs /app/staticfiles /app/media \
    && chown -R appuser:appuser /app

COPY requirements-micro.txt .
RUN python -m pip install --no-cache-dir -r requirements-micro.txt

COPY --chown=appuser:appuser . .
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8000), timeout=3).close()" || exit 1

CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "expense_calculator.asgi:application"]
